# Backend (copy relevant vars into backend/.env — never commit the real file)
DATABASE_URL=postgresql+psycopg://appuser:apppass@localhost:5432/aipcc
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_MINUTES=1440
ENVIRONMENT=development

# Frontend (copy into frontend/.env.local)
# Relative path: requests go through the Next.js rewrite proxy in frontend/next.config.ts
# (same-origin, zero CORS). Only set this to an absolute URL if you want the browser to call
# the backend directly instead.
NEXT_PUBLIC_API_URL=/api/v1
# Server-side only (never exposed to the browser) — the real backend origin the proxy above
# forwards `/api/v1/*` to. Defaults to http://localhost:8000 if unset; in production, point it
# at the deployed backend host.
BACKEND_ORIGIN=http://localhost:8000

# --- Phase 2 (AI layer) ---
# Local Redis (docker-compose service "redis") backs the AIRouter cache/rate-limiter:
REDIS_URL=redis://localhost:6379/0
# Leave these unset to run the AI layer in Demo AI mode (no live provider calls, no key
# needed — this is the default and what the public demo runs on). Set real, freshly-rotated
# keys here (never in chat, never committed) to activate live Gemini/Groq calls automatically —
# no code changes required.
# GEMINI_API_KEY=
# GROQ_API_KEY=
